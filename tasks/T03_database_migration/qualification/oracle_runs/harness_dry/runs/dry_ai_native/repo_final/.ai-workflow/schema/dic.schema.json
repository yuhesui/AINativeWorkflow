{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable Intent Contract Package Manifest",
  "type": "object",
  "required": [
    "schema", "id", "plan_id", "phase_id", "owner", "objective",
    "acceptance_conditions", "evidence_requirements", "views", "custom_views_allowed"
  ],
  "properties": {
    "schema": {"const": "ai-native-workflow/dic-package/2"},
    "owner": {"enum": ["Main", "Theory", "Experiment"]},
    "views": {
      "type": "object",
      "required": ["README.md", "REQUESTS.md", "PLAN.md"],
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "required"],
        "properties": {
          "kind": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "custom_views_allowed": {"const": true},
    "acceptance_conditions": {"type": "array"},
    "evidence_requirements": {"type": "array"}
  }
}
