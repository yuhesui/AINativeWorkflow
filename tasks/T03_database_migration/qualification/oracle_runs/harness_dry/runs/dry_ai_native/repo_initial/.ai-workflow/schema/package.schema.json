{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Native Workflow canonical state",
  "type": "object",
  "required": [
    "schema_version",
    "governance",
    "plans",
    "checkpoints",
    "escalations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "active_plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plans": {
      "type": "object"
    },
    "governance": {
      "type": "object",
      "required": [
        "checkpoint_interval",
        "ordinary_autonomy"
      ]
    },
    "checkpoints": {
      "type": "array"
    },
    "escalations": {
      "type": "array"
    }
  }
}
